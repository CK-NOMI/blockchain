# 前端 mock 模式（设为 false 走真实组件+真实后端）
VITE_USE_MOCK=true
# ===== 后端配置 (agrichain-backend) =====
PORT=3001
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=7d

# FISCO BCOS
WEBASE_FRONT_URL=http://127.0.0.1:5002/WeBASE-Front

# 部署者私钥（对应地址由 WeBASE-Front 密钥管理导入）
DEPLOYER_PRIVATE_KEY=your-private-key-here

# 合约地址（本地节点部署，填入自己部署后获得的地址）
ROLE_MANAGER_ADDRESS=0xYourRoleManagerAddressHere
TRACE_MANAGER_ADDRESS=0xYourTraceManagerAddressHere
AUDIT_MANAGER_ADDRESS=0xYourAuditManagerAddressHere

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agrichain
DB_USER=root
DB_PASS=your-password

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
